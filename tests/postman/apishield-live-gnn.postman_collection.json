            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/workshop/api/shop/orders",
            "description": "Repeated POST /orders is the flooder shape (self-loop on POST orders). Score should stay high / FLAG."
          }
        }
      ]
    },
    {
      "name": "5. BFLA privileged APIs (expect FLAG)",
      "item": [
        {
          "name": "GET management users/all",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/workshop/api/management/users/all?limit=10&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["workshop", "api", "management", "users", "all"],
              "query": [
                { "key": "limit", "value": "10" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "GET mechanic list",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workshop/api/mechanic/"
          }
        },
        {
          "name": "GET mechanic service_requests",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/workshop/api/mechanic/service_requests?limit=30&offset=0",
              "host": ["{{baseUrl}}"],
              "path": ["workshop", "api", "mechanic", "service_requests"],
              "query": [
                { "key": "limit", "value": "30" },
                { "key": "offset", "value": "0" }
              ]
            }
          }
        },
        {
          "name": "GET mechanic_report (guessed id)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/workshop/api/mechanic/mechanic_report?report_id=1",
              "host": ["{{baseUrl}}"],
              "path": ["workshop", "api", "mechanic", "mechanic_report"],
              "query": [{ "key": "report_id", "value": "1" }]
            },
            "description": "400 is fine. GNN cares that a shop user hit mechanic/management nodes."
          }
        }
      ]
    }
  ]
}
