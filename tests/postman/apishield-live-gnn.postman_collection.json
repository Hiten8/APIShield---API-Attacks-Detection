            "url": "{{baseUrl}}/workshop/api/shop/orders/4"
          }
        },
        {
          "name": "GET order 5",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workshop/api/shop/orders/5"
          }
        },
        {
          "name": "GET order 6",
          "request": {
            "method": "GET",
