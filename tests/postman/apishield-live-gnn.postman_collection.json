            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/workshop/api/shop/orders/10",
            "description": "By here you should already have FLAG* if the session had 4+ events. Status 200 vs 403 does not matter for the GNN."
          }
        }
      ]
    },
    {
      "name": "4. Order flooder (expect FLAG)",
      "item": [
        {
          "name": "POST order A",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"product_id\": {{productId}},\n  \"quantity\": 1\n}"
            },
            "url": "{{baseUrl}}/workshop/api/shop/orders"
          }
        },
        {
          "name": "POST order B",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
