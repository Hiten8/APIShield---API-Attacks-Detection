<mxfile host="app.diagrams.net" agent="APIShield" version="22.1.0">
  <diagram id="gnn-window" name="GNN rolling window">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="1100" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="Right branch: rolling window → directed graph → GINE score" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#5a2d82;" vertex="1" parent="1">
          <mxGeometry x="140" y="16" width="880" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="sess" value="One session (session_id)&#xa;ordered API events e1, e2, … ek" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="55" width="360" height="55" as="geometry"/>
        </mxCell>

        <mxCell id="winBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="140" width="1000" height="150" as="geometry"/>
        </mxCell>
        <mxCell id="winTitle" value="1. Cut a rolling window of N events (N = 16). Live stride = 1: always the last N." style="text;html=1;align=left;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="148" width="700" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="eA" value="e_{k-15}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="110" y="190" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="eB" value="e_{k-14}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="210" y="190" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="eC" value="…" style="text;html=1;align=center;fontSize=18;" vertex="1" parent="1">
          <mxGeometry x="300" y="190" width="40" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="eD" value="e_{k-1}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="350" y="190" width="80" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="eE" value="e_k  (now)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="190" width="90" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="dt" value="edge Δt between consecutive events" style="text;html=1;align=left;fontSize=11;fontColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="110" y="245" width="280" height="24" as="geometry"/>
        </mxCell>
        <mxCell id="noteN" value="If the session has fewer than N events,&#xa;the whole session is one window (no padding).&#xa;Live: do not score until min_events = 4." style="text;html=1;align=left;fontSize=11;fontColor=#7f6000;" vertex="1" parent="1">
          <mxGeometry x="680" y="185" width="370" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="s1" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fillColor=#000000;" edge="1" parent="1" source="sess" target="winBox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="map" value="2. Flatten URLs to OpenAPI templates&#xa;GET /workshop/api/shop/orders/8  and  GET /orders/99&#xa;→ same node:  GET /workshop/api/shop/orders/{order_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="280" y="310" width="600" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s2" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fillColor=#000000;" edge="1" parent="1" source="winBox" target="map">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="gBox" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="410" width="1000" height="250" as="geometry"/>
        </mxCell>
        <mxCell id="gTitle" value="3. Encode the window as a directed transition graph" style="text;html=1;align=left;fontStyle=1;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="95" y="418" width="500" height="24" as="geometry"/>
        </mxCell>

        <mxCell id="n1" value="POST&#xa;/auth/login" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="150" y="470" width="110" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n2" value="GET&#xa;/shop/products" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="360" y="470" width="120" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n3" value="GET&#xa;/orders/{order_id}" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="580" y="470" width="130" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n4" value="GET&#xa;/orders/all" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="800" y="470" width="110" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="ed1" value="Δt" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fillColor=#000000;" edge="1" parent="1" source="n1" target="n2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed2" value="Δt" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fillColor=#000000;" edge="1" parent="1" source="n2" target="n3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="ed3" value="self-loop&#xa;count + Δt" style="curved=1;endArrow=block;endFill=1;html=1;strokeColor=#000000;fillColor=#000000;exitX=0.75;exitY=0;entryX=1;entryY=0.25;" edge="1" parent="1" source="n3" target="n3">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="450"/>
              <mxPoint x="740" y="490"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="ed4" value="Δt" style="endArrow=block;endFill=1;html=1;rounded=0;strokeColor=#000000;fillColor=#000000;" edge="1" parent="1" source="n3" target="n4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="feat" value="Node: vocab embed + visits, inbound Δt, error fraction&#xa;Edge: transition count, mean/min Δt (log1p)&#xa;Graph extras: #events, mean/min Δt, #nodes, max self-loop count" style="rounded=0;whiteSpace=wrap;html=1;align=left;fillColor=#ffffff;strokeColor=#9673a6;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="150" y="575" width="850" height="65" as="geometry"/>
        </mxCell>

        <mxCell id="s3" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fillColor=#000000;" edge="1" parent="1" source="map" target="gBox">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="gnn" value="4. WindowGNN (binary GINE)&#xa;embed nodes → 2 × GINEConv (edge-aware) → dropout&#xa;global mean pool  ⊕  global max pool  ⊕  graph extras&#xa;MLP → 1 logit → sigmoid = window attack score" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5a2d82;fontColor=#ffffff;strokeColor=#5a2d82;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="230" y="690" width="700" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="s4" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fillColor=#000000;" edge="1" parent="1" source="gBox" target="gnn">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="agg" value="5. Session aggregation&#xa;session_score = max(all window scores so far)&#xa;FLAG if session_score ≥ τ  (τ ≈ 0.51)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="810" width="600" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="s5" style="endArrow=block;endFill=1;html=1;strokeWidth=2;strokeColor=#000000;fillColor=#000000;" edge="1" parent="1" source="gnn" target="agg">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="cap" value="Enumeration / flooder ≈ heavy self-loops + small Δt. Normal browse ≈ mixed nodes, slower Δt. BOLA looks like a short enum (same template), not “wrong owner”." style="text;html=1;align=center;fontSize=11;fontColor=#333333;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="140" y="900" width="880" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
