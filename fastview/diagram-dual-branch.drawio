<mxfile host="app.diagrams.net" agent="APIShield" version="22.1.0">
  <diagram id="dual-branch" name="Conformance + GNN">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="APIShield live path: one event, two branches, one report" style="text;html=1;align=center;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1a365d;" vertex="1" parent="1">
          <mxGeometry x="180" y="20" width="800" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="in" value="HTTP request (browser / Postman)&#xa;method, path, query, body, headers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="60" width="300" height="60" as="geometry"/>
