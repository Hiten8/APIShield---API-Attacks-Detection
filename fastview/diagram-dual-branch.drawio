        <mxCell id="leftTitle" value="Left branch — OpenAPI conformance" style="text;html=1;align=center;fontSize=14;fontStyle=1;fontColor=#1c4587;" vertex="1" parent="1">
          <mxGeometry x="80" y="258" width="380" height="28" as="geometry"/>
        </mxCell>

        <mxCell id="l1" value="Match path to OpenAPI template&#xa;e.g. /orders/8 → /orders/{order_id}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="130" y="300" width="280" height="55" as="geometry"/>
